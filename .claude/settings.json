{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(cd backend && uv run pytest*)",
      "Bash(cd backend && uv run ruff*)",
      "Bash(cd backend && uv run ty*)",
      "Bash(cd backend && uv run alembic*)",
      "Bash(make governance-*)",
      "Bash(make preflight-*)",
      "Bash(make compose-check*)",
      "Bash(make lint*)",
      "Bash(make test*)",
      "Bash(make frontend-test*)",
      "Bash(uv run --project tools/repo_governance*)",
      "Bash(uv run --directory backend pytest*)",
      "Bash(uv run --directory backend ruff*)",
      "Bash(uv run --directory backend ty*)",
      "Bash(uv run --directory backend alembic*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR/tools/repo_governance\" governance hook session-context",
            "timeout": 60,
            "statusMessage": "Governance orientation"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -c 'import json,sys,os; d=json.load(sys.stdin); p=(d.get(\"tool_input\") or {}).get(\"file_path\") or \"\"; n=p.replace(chr(92),\"/\"); ok=(not p) or os.path.exists(p) or (\"/Temp/claude/\" in n); print(json.dumps({\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}} if ok else {\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"NEW file: \"+p+\" - prefer editing an existing file; create only if genuinely needed.\"}}))'",
            "timeout": 15,
            "statusMessage": "New-file gate"
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/governance_gate.py\"",
            "timeout": 5,
            "statusMessage": "Governance read gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/governance_touched.py\"",
            "timeout": 5,
            "statusMessage": "Governance touched log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR/tools/repo_governance\" governance hook stop-check",
            "timeout": 120,
            "statusMessage": "Governance stop check"
          }
        ]
      }
    ]
  }
}
