# fullstack Environment Variables

# === Project ===
PROJECT_NAME=fullstack
DEBUG=true
DB_ECHO=false  # Set to true to log SQL queries
ENVIRONMENT=local
TIMEZONE=EDT  # IANA timezone: UTC, Europe/Warsaw, America/Detroit
MODELS_CACHE_DIR=./models_cache

# === Logfire ===
# Get your token at https://logfire.pydantic.dev
LOGFIRE_TOKEN=pylf_v2_us_a2108c2f-f684-4dc7-8b31-6e0c0e9bfb32_0kCmxZ8QnRG75mWWL31Zm2MVNlDBTXrG709cM76FWGWC
LOGFIRE_SERVICE_NAME=fullstack
LOGFIRE_ENVIRONMENT=development


# === PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fullstack

# === JWT Auth ===
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === API Key Auth ===
API_KEY=change-me-in-production
API_KEY_HEADER=X-API-Key

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0

# === RAG Configuration ===
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_CHUNKING_STRATEGY=recursive  # recursive, markdown, or fixed
RAG_HYBRID_SEARCH=false  # Enable BM25 + vector hybrid search
RAG_ENABLE_OCR=false  # OCR fallback for scanned PDFs (requires tesseract-ocr installed)
# Vector Database (pgvector) — uses existing PostgreSQL connection
# Reranker
RERANKER_PROVIDER=docker_model_runner
CROSS_ENCODER_MODEL=huggingface.co/keisuke-miyako/gte-reranker-modernbert-base-gguf-q8_0:Q8_0
RERANKER_BASE_URL=http://localhost:12434
RERANKER_TIMEOUT_SECONDS=120
RERANKER_MAX_RETRIES=3
# === PDF Parser Selection ===
# RAG ingestion parser: docling, pymupdf, llamaparse
PDF_PARSER=docling
# Chat PDF parser: docling with PyMuPDF fallback, or pymupdf/llamaparse
CHAT_PDF_PARSER=docling
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIER=agentic  # fast, cost_effective, agentic, agentic_plus
DOCLING_SERVE_URL=http://localhost:5001
DOCLING_SERVE_TIMEOUT_SECONDS=600
DOCLING_SERVE_MAX_RETRIES=2
# Image Description (LLM vision)
RAG_IMAGE_DESCRIPTION_MODEL=  # empty = use AI_MODEL
# Google Drive (service account)
GOOGLE_DRIVE_CREDENTIALS_FILE=credentials/google-drive-sa.json
# S3/MinIO (document ingestion)
S3_RAG_ENDPOINT=
S3_RAG_ACCESS_KEY=
S3_RAG_SECRET_KEY=
S3_RAG_BUCKET=fullstack-rag
S3_RAG_REGION=us-east-1

# === Taskiq ===
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND=redis://localhost:6379/2
TASKIQ_MAX_ASYNC_TASKS=1

# === S3/MinIO Storage ===
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fullstack
S3_REGION=us-east-1


# === AI Agent (pydantic_ai, openrouter) ===
OPENROUTER_API_KEY=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
AI_MODEL=anthropic/claude-sonnet-5
AI_THINKING_ENABLED=true
AI_THINKING_EFFORT=medium  # low, medium, high

# === Web Search (Tavily) ===
# Get your API key at https://tavily.com
TAVILY_API_KEY=

# === Code execution (Monty sandbox) ===
ENABLE_CODE_EXECUTION=true
CODE_EXECUTION_TIMEOUT_SECS=10
CODE_EXECUTION_MAX_ALLOCATIONS=50000000

ENABLE_DEEP_RESEARCH=true
DEEP_RESEARCH_MAX_TOKENS=120000
DEEP_RESEARCH_COMPRESS_THRESHOLD=0.8

# === MCP Client (Settings → Integrations) ===
# Deployment-managed MCP servers, always attached on top of each user's own
# connections. JSON list; leave empty to rely purely on per-user connections.
# "name" is a slug (lowercase letters, digits, hyphens) and becomes the prefix
# of that server's tool names, so it must not clash with a name your users can
# pick in the marketplace — a clash means their connection is dropped in favour
# of this one. Startup fails on a malformed or duplicated name.
# Secrets stay outside MCP_SERVERS and are injected only into runtime specs.
GITHUB_MCP_TOKEN=
BROWSERLESS_TOKEN=
# Development sidecars (requires the Compose `mcp` profile):
# MCP_SERVERS=[{"name":"docling-internal","url":"http://docling-mcp:8000/mcp","headers":{"Host":"localhost:8000"}},{"name":"chrome-internal","url":"http://chrome-devtools-mcp:8000/mcp"},{"name":"github-internal","url":"http://github-mcp:8082/","auth":"github","allowed_tools":["get_file_contents","search_code","search_issues","issue_read","pull_request_read","list_commits"]}]
MCP_SERVERS=[]
# Per-server budget for the pre-flight ping; unreachable servers are skipped.
MCP_CONNECT_TIMEOUT_SECS=3
# Docker Model Runner embeddings (Qwen 4B; 8B remains benchmark-only opt-in)
OPENAI_API_KEY=
EMBEDDING_BASE_URL=http://localhost:12434/engines/v1
EMBEDDING_API_KEY=local-docker-model-runner
EMBEDDING_MODEL=docker.io/ai/qwen3-embedding:latest
EMBEDDING_MODEL_VERSION=4B-Q4_K_M
EMBEDDING_MODEL_REVISION=731f733db2ef
EMBEDDING_DIMENSION=1024
EMBEDDING_QUERY_INSTRUCTION=Given a user query, retrieve relevant passages, documentation, or code that answer the query.
EMBEDDING_DOCUMENT_INSTRUCTION=
EMBEDDING_CACHE_URL=redis://localhost:6379/3
EMBEDDING_CACHE_TTL_SECONDS=604800
EMBEDDING_CACHE_LOCK_SECONDS=60
EMBEDDING_BATCH_SIZE=64

# Chunking
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# Retrieval
RAG_DEFAULT_COLLECTION=documents
RAG_TOP_K=10

# Reranker

# PDF Parser
PDF_PARSER=docling
CHAT_PDF_PARSER=docling
LLAMAPARSE_API_KEY=

# Direct Google Workspace APIs (optional; use the "Full Stack" Web OAuth client).
# Per-user refresh tokens are obtained in Settings -> Integrations and encrypted.
GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=

# Google Drive RAG ingestion is a separate service-account connector.
# See GOOGLE_DRIVE_CREDENTIALS_FILE above; per-user OAuth credentials do not replace it.

# === Email ===
EMAIL_FROM=stevenmpollmann@gmail.com
EMAIL_FROM_NAME=Steven
# EMAIL_PROVIDER=log (default dev mode — prints to stdout)

# === CORS ===
# JSON list of allowed origins (default: localhost:3000, localhost:8080)
# Note: "*" is blocked in production - specify explicit origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === Docker Production (Traefik) ===
# Domain for production deployment
DOMAIN=example.com

# Let's Encrypt email for SSL certificates
ACME_EMAIL=stevenmpollmann@gmail.com

# Traefik dashboard auth (generate with: htpasswd -nb admin password)
# TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$...
# Redis password for production
REDIS_PASSWORD=change-me-in-production
