{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fullstack-governance:schemas/component/v1",
  "title": "Components manifest",
  "description": "Compiled from directory annotations and curated declarations. A component is declared in exactly one of the two, never both.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "components"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Values a declaration inherits when it does not set them itself. Only documented fields may be inherited; nothing here can weaken security or compatibility policy.",
      "properties": {
        "allowed_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "forbidden_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "websocket_events": {
      "type": "array",
      "description": "The WebSocket event inventory. Curated because these events are ad-hoc dicts with no schema anywhere in the codebase — enumerating them is a governance deliverable, not an extraction. The producer/consumer set difference is the compatibility check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "direction"],
        "properties": {
          "type": {
            "type": "string"
          },
          "direction": {
            "enum": ["server-to-client", "client-to-server"]
          },
          "producer_ref": {
            "type": ["string", "null"]
          },
          "consumer_ref": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "configuration_classifications": {
      "type": "array",
      "description": "Curated judgments about the configuration surface that extraction cannot make: which variables are secrets, which are deprecated aliases, which are computed properties rather than settable inputs, and which appear in a template with no reader. The configuration extractor enumerates variables and merges these in; it never infers them. Secret status in particular cannot be derived from types here, because secret fields are inconsistently typed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "classification", "reason"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "classification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "runtime",
                "build-arg",
                "computed",
                "secret",
                "deprecated-alias",
                "compose-only",
                "unknown-consumer"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "alias_of": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "removal_milestone": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "contains": {
                    "const": "deprecated-alias"
                  }
                }
              },
              "required": ["classification"]
            },
            "then": {
              "required": ["alias_of", "removal_milestone"]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "path": {
      "type": "string",
      "description": "Repo-root-relative, forward-slash. Multi-root ownership is expressible because paths are never relative to an annotation's own directory.",
      "pattern": "^[^\\\\]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "extractor_version"],
      "properties": {
        "method": {
          "enum": ["extracted", "reviewed-baseline", "curated", "merged"]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extractor_version": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "purpose", "declared_in", "owns"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug",
          "description": "Stable and independent of directory names, so a file move is an identity update rather than a new component."
        },
        "kind": {
          "enum": [
            "backend-subsystem",
            "frontend-feature",
            "agent-runtime",
            "mcp-sidecar",
            "image-only-service",
            "host-runtime",
            "db-resident-surface",
            "infrastructure",
            "data",
            "observability",
            "governance"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "declared_in": {
          "enum": ["annotation", "curated"]
        },
        "annotation_path": {
          "$ref": "#/$defs/path",
          "description": "Present only when declared_in is `annotation`."
        },
        "owns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "description": "Glob patterns. May span multiple roots; may be empty for components with no files at all (a host runtime, a database-resident surface)."
        },
        "entrypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "public_interfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "forbidden_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "configuration_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "compose_services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Compose service names this component is realized by. Curated rather than extracted: the services manifest is pure extraction, and which component a service belongs to is a judgment about intent, not a fact readable from a Compose file."
        },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          },
          "description": "Derived at sync from the `components` list in each ADR's front matter — never declared here or in a directory annotation. Only ADRs with status `accepted` or `proposed` are carried, because a superseded decision's successor holds the constraint."
        },
        "finding_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Open findings that constrain this component, so `explain` can surface them without a history scan."
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Trusted validator IDs resolved through governance/validators.json. Never executable shell text."
        },
        "generator_feature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flag", "enabled"],
          "properties": {
            "flag": {
              "type": "string"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "description": "Sourced from .fastapi-fullstack.json. A disabled feature's surfaces are expected-present-unused, not orphans."
        },
        "graph_hints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "entry_symbols": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exclude": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "declared_in": {
                "const": "annotation"
              }
            },
            "required": ["declared_in"]
          },
          "then": {
            "required": ["annotation_path"]
          },
          "else": {
            "not": {
              "required": ["annotation_path"]
            }
          }
        }
      ]
    }
  }
}
