{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fullstack-governance:schemas/decision-index/v1",
  "title": "Decision index",
  "description": "Generated index of architecture decision records, built from each ADR's front matter. Lets context and impact queries find relevant decisions without reading every ADR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "decisions"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status", "date", "file"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["proposed", "accepted", "superseded", "deprecated", "rejected"],
            "description": "`deprecated` is a decision retired with no successor; `superseded` is one replaced by a named ADR. The distinction matters because a superseded decision has somewhere to send the reader and a deprecated one does not."
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ADR-\\d{3}$"
            },
            "description": "Declared in the superseding ADR's front matter."
          },
          "superseded_by": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ADR-\\d{3}$"
            },
            "description": "Derived from every other ADR's `supersedes`, never declared. Two declarations of one relationship is the drift this index exists to remove."
          },
          "related_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Optional globs. `governance context` joins them to the paths under change directly, so an ADR reaches a briefing even when no component carries it."
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "description": "Policy rule ids this decision is enforced by. Checked to resolve across governance/policies/*.json."
          },
          "file": {
            "type": "string",
            "pattern": "^[^\\\\]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "extractor_version"],
      "properties": {
        "method": {
          "enum": ["extracted", "reviewed-baseline", "curated", "merged"]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extractor_version": {
          "type": "string"
        }
      }
    }
  }
}
